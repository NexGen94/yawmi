{
  "name": "yawmi-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:api": "node tools/openapi-gen/node_modules/openapi-typescript/bin/cli.js ../openapi/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "check:budget": "node scripts/check-budget.mjs",
    "e2e": "playwright test",
    "icons": "pwa-assets-generator && node scripts/move-icons.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "openapi-fetch": "0.17.0",
    "preact": "11.2.0",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "24.19.2",
    "@vite-pwa/assets-generator": "2.0.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
