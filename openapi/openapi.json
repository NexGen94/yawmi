            "title": "Loc",
            "type": "array"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationErrorItem",
        "type": "object"
      }
    },
