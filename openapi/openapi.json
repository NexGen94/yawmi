              }
            },
            "description": "طلب غير صالح"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "رفع مقاييس يوم واحد وحساب درجاته",
        "tags": [
          "health"
        ]
      }
    },
