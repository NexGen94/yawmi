                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Score"
          }
        },
        "required": [
          "day",
          "recovery_score"
        ],
        "title": "TrendPoint",
        "type": "object"
      },
      "ValidationErrorBody": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ValidationErrorItem"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
