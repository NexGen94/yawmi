            "type": "string"
          },
          "recovery_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0–100، أو null إن لم يكتمل خط الأساس",
            "title": "Recovery Score"
          },
          "strain_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0–21 بمنزلة عشرية واحدة",
            "title": "Strain Score"
          }
        },
        "required": [
          "day",
          "recovery_score",
          "strain_score",
          "data_quality",
          "baseline"
        ],
        "title": "DailyScoresOut",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "EventBatch": {
        "description": "`POST /v1/events` body: at most 500 events (more is a 422, like any other bad body).",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "maxItems": 500,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventBatch",
        "type": "object"
      },
      "EventIn": {
        "description": "One event as a client queues it.\n\n`device_id` is never read from the body (the token's `sub` is used) and unknown fields are\nignored.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "type": {
            "enum": [
              "habit_logged",
              "habit_skipped",
              "habit_vacation",
              "day_closed",
              "focus_started",
              "focus_ended",
              "breath_ended",
              "mood_logged",
              "confounder_tagged",
              "app_opened"
            ],
            "title": "Type",
            "type": "string"
          },
          "tz": {
            "default": "Asia/Riyadh",
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "payload",
          "occurred_at"
        ],
        "title": "EventIn",
        "type": "object"
      },
      "ExertionSegment": {
        "additionalProperties": false,
        "properties": {
          "hr_reserve": {
            "description": "احتياطي النبض من 0 إلى 1",
