    "/v1/events": {
      "get": {
        "description": "مرتبة بوقت الاستلام في الخادم. `next_since` هو وقت استلام آخر حدث مُعاد (أو قيمة `since` نفسها إن لم يوجد جديد)، فيُمرَّر في الطلب التالي. لا تنقسم الصفحة داخل مجموعة أحداث تشترك في وقت الاستلام نفسه، فقد تزيد على `limit`. يجب ترميز `+` في `since` بـ`%2B` أو استعمال `Z`.",
        "operationId": "pull_events_v1_events_get",
        "parameters": [
          {
            "description": "أحداث استُلمت بعد هذا الوقت (ISO 8601 بمنطقة زمنية)",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "أحداث استُلمت بعد هذا الوقت (ISO 8601 بمنطقة زمنية)",
              "title": "Since"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "غير مصرّح"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "طلب غير صالح"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "سحب الأحداث بمؤشر زمني",
        "tags": [
          "events"
        ]
      },
      "post": {
        "description": "حتى 500 حدثاً في الدفعة. معرّف الحدث هو مفتاح التكرار: إعادة إرسال الدفعة نفسها لا تضاعف شيئاً ولا تُرفض. `habit_logged` و`habit_skipped` و`habit_vacation` و`focus_ended` و`breath_ended` تُسقَط أيضاً إلى جداولها؛ بقية الأنواع تُحفظ في الأحداث فقط.",
        "operationId": "post_events_v1_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "غير مصرّح"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "غير مسموح (رمز الخدمة لا يسجّل أحداثاً)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "طلب غير صالح: الدفعة تُرفض كاملة"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "استقبال دفعة أحداث (متكررة الأثر)",
        "tags": [
          "events"
        ]
      }
    },
    "/v1/health/daily": {
      "post": {
        "description": "يحسب الخادم التعافي والإجهاد وجودة البيانات بخط أساس شخصي من الليالي الصالحة في الأيام الـ28 السابقة: لا خط أساس قبل 7 ليالٍ، و«أولي» حتى 27، و«كامل» من 28. إعادة إرسال اليوم نفسه تستبدله. عند رفع عدة أيام يُرسل الأقدم أولاً، فاليوم يُقاس بما سبقه مخزناً، ولا يُعاد حساب الأيام التالية عند وصول يوم أقدم. حقل غير معروف يُرفض. تقدير، ليس تشخيصاً.",
        "operationId": "post_daily_v1_health_daily_post",
