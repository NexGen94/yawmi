              }
            ],
            "description": "رقم الدورة الحالية، وأسبوع مراجعتها منها",
            "title": "Cycle"
          },
          "day_in_cycle": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "1 في أول يوم من الدورة",
            "title": "Day In Cycle"
          },
          "focus_outcomes": {
            "description": "مخرجات لها محطات مفتوحة في هذه الدورة",
            "items": {
              "type": "string"
            },
            "title": "Focus Outcomes",
            "type": "array"
          }
        },
        "required": [
          "cycle",
          "day_in_cycle",
          "focus_outcomes"
        ],
        "title": "TodayPlan",
        "type": "object"
      },
      "TokenPair": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "required": [
          "device_id",
          "access_token",
          "refresh_token"
        ],
        "title": "TokenPair",
        "type": "object"
      },
      "TrendPoint": {
        "properties": {
