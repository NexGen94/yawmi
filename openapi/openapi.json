      }
    },
    "/v1/today": {
      "get": {
        "description": "اليوم المحلي بتوقيت الرياض. `habits_due` العادات المجدولة اليوم؛ و`health` درجات اليوم واتجاه سبعة أيام (يوم بلا ساعة «ناقص» لا صفر)؛ و`plan` الدورة الحالية من مرآة Notion.",
        "operationId": "get_today_v1_today_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodayOut"
