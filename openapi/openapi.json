{
  "components": {
    "schemas": {
      "BaselineOut": {
        "properties": {
          "nights": {
            "description": "أقل عدد ليالٍ صالحة خلف خطوط الأساس الثلاثة",
            "title": "Nights",
            "type": "integer"
          },
          "quality": {
            "enum": [
              "provisional",
              "full"
            ],
            "title": "Quality",
            "type": "string"
          }
        },
        "required": [
          "quality",
          "nights"
        ],
        "title": "BaselineOut",
        "type": "object"
      },
      "BatchResult": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "duplicates"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "CardHabit": {
        "properties": {
          "adherence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adherence"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "title_ar": {
            "title": "Title Ar",
            "type": "string"
          }
        },
        "required": [
          "code",
          "title_ar",
          "adherence"
        ],
        "title": "CardHabit",
        "type": "object"
      },
      "CardOut": {
        "properties": {
          "habits": {
            "description": "العادات المرتبطة بالبطاقة (تملؤها المهمة 10)",
            "items": {
              "$ref": "#/components/schemas/CardHabit"
            },
            "title": "Habits",
            "type": "array"
          },
          "outcome_codes": {
            "items": {
              "type": "string"
            },
            "title": "Outcome Codes",
            "type": "array"
          },
          "page_id": {
            "title": "Page Id",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "page_id",
          "title",
          "status",
          "outcome_codes",
          "habits"
        ],
        "title": "CardOut",
        "type": "object"
      },
      "DailyMetricsIn": {
        "additionalProperties": false,
        "description": "One local day of raw metrics. Every metric is optional: a gap is missing, never zero.\n\nUnknown fields are a 422 (`extra_forbidden`), so a misnamed metric is never silently lost.",
        "properties": {
          "active_kcal": {
            "anyOf": [
              {
                "maximum": 50000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Kcal"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "exercise_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exercise Minutes"
          },
          "exertion": {
            "description": "مقاطع الجهد لحساب TRIMP؛ تُترك فارغة إن لم يوجد",
            "items": {
              "$ref": "#/components/schemas/ExertionSegment"
            },
            "maxItems": 500,
            "title": "Exertion",
            "type": "array"
          },
          "has_watch_night": {
            "description": "هل لبست الساعة في النوم المنسوب إلى اليوم",
            "title": "Has Watch Night",
            "type": "boolean"
          },
          "hrv_ms": {
            "anyOf": [
              {
                "maximum": 1000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "HRV الليلي (SDNN)",
            "title": "Hrv Ms"
          },
          "hrv_rmssd_ms": {
            "anyOf": [
              {
                "maximum": 1000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hrv Rmssd Ms"
          },
          "hrv_samples": {
            "description": "عدد عيّنات HRV في الليلة",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Hrv Samples",
            "type": "integer"
          },
          "in_bed_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Bed Minutes"
          },
          "mindful_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mindful Minutes"
          },
          "resp_rate_bpm": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resp Rate Bpm"
          },
          "rhr_bpm": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 300.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rhr Bpm"
          },
          "sleep_awake_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Awake Minutes"
          },
          "sleep_core_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Core Minutes"
          },
          "sleep_deep_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Deep Minutes"
          },
          "sleep_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep End"
          },
          "sleep_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Minutes"
          },
          "sleep_rem_minutes": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Rem Minutes"
          },
          "sleep_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleep Start"
          },
          "sleeping_hr_bpm": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 300.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleeping Hr Bpm"
          },
          "spo2_pct": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spo2 Pct"
          },
          "steps": {
            "anyOf": [
              {
                "maximum": 1000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps"
          },
          "trimp_coefficients": {
            "anyOf": [
              {
                "enum": [
                  "male",
                  "female"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "معاملات Banister (0.64/1.92 أو 0.86/1.67)؛ مطلوبة إن أُرسلت مقاطع جهد",
            "title": "Trimp Coefficients"
          },
          "walking_hr_bpm": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 300.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Walking Hr Bpm"
          },
          "wrist_temp_delta_c": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": -10.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wrist Temp Delta C"
          }
        },
        "required": [
          "day",
          "has_watch_night",
          "hrv_samples"
        ],
        "title": "DailyMetricsIn",
        "type": "object"
      },
      "DailyScoresOut": {
        "properties": {
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BaselineOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_quality": {
            "enum": [
              "missing",
              "low",
              "ok"
            ],
            "title": "Data Quality",
            "type": "string"
          },
          "day": {
            "format": "date",
